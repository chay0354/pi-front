{

  "cli": {

    "version": ">= 7.0.0",

    "appVersionSource": "local"

  },

  "build": {

    "development": {

      "developmentClient": true,

      "distribution": "internal",

      "environment": "preview",

      "node": "20.18.1",

      "env": {

        "_JAVA_OPTIONS": "-Xmx6144m -XX:MaxMetaspaceSize=512m"

      },

      "ios": {

        "simulator": false

      },

      "android": {

        "buildType": "apk",

        "image": "ubuntu-22.04-jdk-17-ndk-r26b"

      }

    },

    "preview": {

      "distribution": "internal",

      "environment": "preview",

      "node": "20.18.1",

      "env": {

        "_JAVA_OPTIONS": "-Xmx6144m -XX:MaxMetaspaceSize=512m"

      },

      "cache": {

        "disabled": true

      },

      "android": {

        "buildType": "apk",

        "image": "ubuntu-22.04-jdk-17-ndk-r26b"

      },

      "ios": {

        "simulator": false

      }

    },

    "production": {

      "environment": "production",

      "node": "20.18.1",

      "android": {

        "buildType": "app-bundle"

      }

    }

  }

}


