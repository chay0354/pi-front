# Optional overrides. Production builds already default to the live API and Supabase
# project, so a Vercel deploy works without setting these. Set them in the Vercel
# project (Settings → Environment Variables) only to point at something else.
# Vite bakes VITE_* values in at build time.

VITE_API_URL=https://pi-back.vercel.app
VITE_SUPABASE_URL=https://opxeruasowoaybceskyp.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
