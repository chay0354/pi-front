# Copy to `.env` for local dev. For EAS APK builds, set the same keys in Expo:
# Project → pi-frontend → Environment variables → Preview (or link CI secrets).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local pi-back (default port 3001 — see pi-back/.env PORT)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional: Google Maps SDK — needed for react-native-maps tiles on real devices.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
