{
  "name": "pi-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8084",
    "web:9000": "expo start --web --port 9000",
    "web:clear": "expo start --web --port 8084 --clear",
    "web:nocache": "powershell -ExecutionPolicy Bypass -File scripts/start-web-fresh.ps1",
    "web:dev": "node scripts/start-web-dev.js",
    "web:lan": "expo start --web --port 8084",
    "web:fresh": "powershell -ExecutionPolicy Bypass -File scripts/start-web-fresh.ps1",
    "open-web": "start http://localhost:8084",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "download:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-apk.ps1"
  },
  "dependencies": {
    "@expo/webpack-config": "~19.0.1",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@supabase/supabase-js": "^2.39.0",
    "expo": "~50.0.21",
    "expo-av": "~13.10.6",
    "expo-constants": "~15.4.6",
    "expo-font": "~11.10.3",
    "expo-image-picker": "~14.7.1",
    "expo-linear-gradient": "~12.7.2",
    "expo-splash-screen": "~0.26.5",
    "expo-status-bar": "~1.11.1",
    "html2canvas": "^1.4.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.6",
    "react-native-calendars": "^1.526.0",
    "react-native-maps": "1.10.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-svg": "14.1.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "3.8.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
