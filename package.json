{
  "name": "pi-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:device": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-android-device.ps1",
    "android:emu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emu.ps1",
    "android:emu:he": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-hebrew-emulator.ps1",
    "android:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-api.ps1",
    "test:emu-registration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/simulate-emulator-registration.ps1",
    "android:fix-network": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-emulator-network.ps1",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-android-dev.ps1",
    "ios": "expo run:ios",
    "ios:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ios-dev.ps1",
    "web": "expo start --web --port 8084",
    "web:9000": "expo start --web --port 9000",
    "web:clear": "expo start --web --port 8084 --clear",
    "web:nocache": "powershell -ExecutionPolicy Bypass -File scripts/start-web-fresh.ps1",
    "web:dev": "node scripts/start-web-dev.js",
    "web:lan": "expo start --web --port 8084",
    "web:fresh": "powershell -ExecutionPolicy Bypass -File scripts/start-web-fresh.ps1",
    "open-web": "start http://localhost:8084",
    "build:apk": "node scripts/clean-dist-for-eas.js && npx eas-cli@latest build --platform android --profile preview --non-interactive",
    "build:bundle": "node scripts/clean-dist-for-eas.js && cd android && gradlew.bat bundleRelease",
    "download:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-apk.ps1"
  },
  "dependencies": {
    "@expo-google-fonts/alef": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-hebrew": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/secular-one": "^0.4.1",
    "@expo/metro-runtime": "~3.1.3",
    "@expo/webpack-config": "~19.0.1",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/netinfo": "11.1.0",
    "@react-native-google-signin/google-signin": "^10.1.2",
    "@supabase/supabase-js": "^2.39.0",
    "expo": "~50.0.21",
    "expo-apple-authentication": "~6.3.0",
    "expo-auth-session": "~5.4.0",
    "expo-av": "~13.10.6",
    "expo-build-properties": "~0.11.1",
    "expo-clipboard": "~5.0.1",
    "expo-constants": "~15.4.6",
    "expo-crypto": "~12.8.1",
    "expo-dev-client": "~3.3.12",
    "expo-document-picker": "~11.10.1",
    "expo-font": "~11.10.3",
    "expo-haptics": "~12.8.1",
    "expo-image-picker": "~14.7.1",
    "expo-linear-gradient": "~12.7.2",
    "expo-location": "~16.5.5",
    "expo-secure-store": "~12.8.1",
    "expo-splash-screen": "~0.26.5",
    "expo-status-bar": "~1.11.1",
    "expo-web-browser": "~12.8.2",
    "html2canvas": "^1.4.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.6",
    "react-native-calendars": "^1.526.0",
    "react-native-maps": "1.10.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-svg": "14.1.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "3.8.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
