{
  "name": "pi-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8084",
    "web:9000": "expo start --web --port 9000",
    "web:clear": "expo start --web --port 8084 --clear",
    "web:nocache": "powershell -ExecutionPolicy Bypass -File scripts/start-web-fresh.ps1",
    "web:dev": "node scripts/start-web-dev.js",
    "web:lan": "expo start --web --port 8084",
    "web:fresh": "powershell -ExecutionPolicy Bypass -File scripts/start-web-fresh.ps1",
    "open-web": "start http://localhost:8084"
  },
  "dependencies": {
    "@expo/webpack-config": "^19.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "expo": "~49.0.0",
    "expo-constants": "~14.4.2",
    "expo-font": "~11.4.0",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "html2canvas": "^1.4.1",
    "react": "18.2.0",
    "react-dom": "^18.3.1",
    "react-native": "0.72.6",
    "react-native-calendars": "^1.526.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-svg": "^15.15.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "3.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
